# Database (Neon PostgreSQL)
# Example: postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/dbname
DATABASE_URL=

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Better Auth URL (for redirects and CORS)
BETTER_AUTH_URL=http://localhost:3000

# App Environment
NODE_ENV=development
